# Neon Postgres connection string (pooled). Also used by drizzle-kit migrate.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth: random secret of at least 32 characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public origin the app is served from (SPA and API share it), e.g. https://example.vercel.app
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated emails allowed to generate invite links (Perfil → Invitar). Case-insensitive.
ADMIN_EMAILS=tu@email.com

NODE_ENV=development

# Web Push for rest-end notifications. Generate once with:
#   pnpm --filter api exec web-push generate-vapid-keys
# Without these, /api/push answers 503 and the app falls back to in-page alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto: or https: (Apple rejects localhost). Defaults to BETTER_AUTH_URL.
VAPID_SUBJECT=mailto:tu@email.com
